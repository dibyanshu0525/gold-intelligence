# Free multi-source architecture (recommended defaults)
# XAUS is keyless and returns XAU/USD plus USD/INR in one request.
XAUS_ENABLED=true
# Gold-API.com is keyless; live price endpoints refresh every 30 seconds.
GOLD_API_COM_ENABLED=true

# Optional independent cross-checks / failover. Keep keys server-side.
# GoldAPI.dev free: 100 requests/hour; its adapter is cached for 5 minutes (three calls per successful refresh).
GOLDAPI_DEV_KEY=
# GoldPrice.dev keyless free feed is 15 minutes delayed (5,000 calls/month).
# Cached for 20 minutes to stay comfortably within the quota.
GOLDPRICE_ENABLED=true
GOLDPRICE_API_KEY=
# Twelve Data is an optional USD/INR backup (free Basic quotas/licensing apply).
TWELVE_DATA_API_KEY=
# Frankfurter is a daily reference-FX fallback; no API key required.
FRANKFURTER_ENABLED=true

# Legacy optional provider; no longer required for the default dashboard.
METALS_DEV_API_KEY=
# Legacy GoldAPI.io key (not GoldAPI.dev). Retained only for backwards compatibility.
GOLDAPI_KEY=

# Polling and backend. XAUS responses are cached by the source for 60s.
POLL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=12
DATABASE_PATH=./data/gold_tracker.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public-page fallback sources. Retail rates may be national-level and delayed.
KALYAN_RATE_URL=https://store.kalyanjewellers.net/gold-rate/india/en
IBJA_RATE_URL=https://ibjarates.com/

# Simplified import-parity assumption; verify current customs notifications.
DEFAULT_IMPORT_DUTY_PCT=15
